{
  "description": "Prepare and restore Jev-selected verbatim context around Codex compaction.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${RUNTIME_ROOT}\\bin\\save-token-jev-hook.mjs\" hook codex",
            "timeout": 120,
            "statusMessage": "Selecting context to preserve with Jev"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${RUNTIME_ROOT}\\bin\\save-token-jev-hook.mjs\" hook codex",
            "timeout": 10,
            "additionalContextLimit": 200000,
            "statusMessage": "Restoring Jev-selected context"
          }
        ]
      }
    ]
  }
}
